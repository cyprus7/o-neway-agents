# Optional overrides; defaults are defined in docker-compose.yml.
# Configure your own inference key. No credentials are bundled.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_ENABLED=
PROVIDER_GATEWAY_URL=

# Set WEB_FALLBACK_ENABLED=0 to block external travel-data HTTP independently of inference.
LOCAL_CATALOG_ENABLED=
WEB_FALLBACK_ENABLED=
OLLAMA_API_KEY=
SERPAPI_API_KEY=
APP_TIMEZONE=
APP_PORT=
APP_ALLOWED_ORIGINS=
APP_PUBLIC_URL=

# Leave commented to use the Compose encoder; uncomment an empty value to disable it.
# EMBEDDING_URL=

# Telegram is optional and disabled by default. Configure your own bot privately.
TELEGRAM_MODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional local tracing: COMPOSE_PROFILES=traces
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
COMPOSE_PROFILES=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_TRACES_SAMPLER_ARG=
OTEL_DEPLOYMENT_ENVIRONMENT=
OTEL_SERVICE_VERSION=
